# Configuration for the office desktop install.
# Copy this to  server.env  in the same folder and fill it in.
# server.env is read by run-server.ps1 and is NOT committed to git.

# -- Required ----------------------------------------------

# The local PostgreSQL. Change the password to the one set during installation.
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/miltenyi

# The database is on this machine, so there is no TLS to negotiate. Without
# this the server tries TLS in production mode and PostgreSQL refuses it with
# "The server does not support SSL connections".
DATABASE_SSL=disable

# Signs login tokens. Generate once and never change it, or everyone is logged
# out. In PowerShell:
#   -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
JWT_SECRET=

# Only used if the users table is empty -- on a migrated database it never is,
# because the accounts come across with the data. Set it anyway so a fresh
# start is not blocked.
ADMIN_PASSWORD=

# -- Networking --------------------------------------------

NODE_ENV=production
PORT=3001

# No reverse proxy in front of this server. Left at 1, the login rate limiter
# trusts an X-Forwarded-For header that anything on the network can set, which
# lets an attacker sidestep it by varying that header. 0 means "judge clients
# by the address they actually connected from".
TRUST_PROXY_HOPS=0

# Every address this server is legitimately reached by, comma-separated. The
# server serves the app itself, so browsers normally call it on its own origin,
# but listing them locks CORS down instead of reflecting whatever asks.
# Use the computer name, the fixed IP, and the VPN address if there is one.
FRONTEND_URL=http://INVENTORY-PC:3001,http://192.168.1.50:3001

# -- Optional ----------------------------------------------

LOG_LEVEL=info
APP_TIMEZONE=Asia/Singapore

# Set to false to stop WhatsApp connecting at startup (useful while testing).
WHATSAPP_AUTOCONNECT=true

# -- Backups -----------------------------------------------

BACKUP_DIR=D:\MiltenyiBackups
BACKUP_KEEP_DAYS=30

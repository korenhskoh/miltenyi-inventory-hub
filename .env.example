# ── Required ──────────────────────────────────────────────
DATABASE_URL=postgres://user:pass@host:5432/miltenyi
# Stable secret for signing JWTs. Server refuses to start in production without it.
#   openssl rand -hex 32
JWT_SECRET=

# Password for the first admin account, used only when the users table is
# empty. The server refuses to seed in production without it.
#   openssl rand -base64 18
ADMIN_PASSWORD=

# TLS for the database connection: disable | no-verify | require
#   disable    database on this machine or a trusted LAN (local desktop install)
#   no-verify  managed host with a self-signed certificate (Railway)
#   require    database reached across an untrusted network
# Left unset, production uses no-verify and everything else uses none, which is
# how this behaved before the setting existed.
DATABASE_SSL=no-verify

# ── Strongly recommended in production ───────────────────
NODE_ENV=production
# Exact origin of the SPA; without it CORS reflects any origin.
FRONTEND_URL=https://your-app.up.railway.app
# Number of reverse-proxy hops in front of the server (Railway = 1)
TRUST_PROXY_HOPS=1

# ── Optional ─────────────────────────────────────────────
PORT=3001
LOG_LEVEL=info

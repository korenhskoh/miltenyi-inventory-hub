# ── Required ──────────────────────────────────────────────
DATABASE_URL=postgres://user:pass@host:5432/miltenyi
# Stable secret for signing JWTs. Server refuses to start in production without it.
#   openssl rand -hex 32
JWT_SECRET=

# ── Strongly recommended in production ───────────────────
NODE_ENV=production
# Exact origin of the SPA; without it CORS reflects any origin.
FRONTEND_URL=https://your-app.up.railway.app
# Number of reverse-proxy hops in front of the server (Railway = 1)
TRUST_PROXY_HOPS=1

# ── Optional ─────────────────────────────────────────────
PORT=3001
LOG_LEVEL=info
